from pathlib import Path
import zipfile, textwrap

root = Path("/mnt/data/rk-garage")
root.mkdir(exist_ok=True)

html = r'''<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RK Garage — Rumah Kita RP</title>
  <meta name="description" content="RK Garage — Bengkel automotif Rumah Kita RP. Servis, performance dan custom build.">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="nav">
    <a class="brand" href="#home"><span>RK</span> GARAGE</a>
    <nav>
      <a href="#home">HOME</a>
      <a href="#services">SERVICES</a>
      <a href="#about">ABOUT</a>
      <a href="#contact">CONTACT</a>
    </nav>
    <a class="nav-btn" href="#contact">BOOK NOW</a>
  </header>

  <main>
    <section id="home" class="hero">
      <div class="hero-glow"></div>
      <div class="hero-content">
        <p class="eyebrow">RUMAH KITA ROLEPLAY • AUTOMOTIVE</p>
        <h1>BUILD IT.<br><em>DRIVE IT.</em><br>OWN IT.</h1>
        <p class="lead">RK Garage — tempat untuk upgrade, repair dan bina jentera yang betul-betul ikut gaya kau.</p>
        <div class="hero-actions">
          <a class="btn primary" href="#services">EXPLORE SERVICES</a>
          <a class="btn ghost" href="#contact">CONTACT GARAGE</a>
        </div>
      </div>
      <div class="hero-card">
        <div class="card-top"><span>RK</span><b>GARAGE</b></div>
        <div class="car-silhouette">RK</div>
        <div class="card-bottom"><span>PERFORMANCE</span><span>•</span><span>CUSTOM</span></div>
      </div>
    </section>

    <section id="services" class="section">
      <div class="section-head">
        <p class="eyebrow">WHAT WE DO</p>
        <h2>GARAGE <em>SERVICES</em></h2>
        <p>Servis lengkap untuk memastikan kereta kau sentiasa ready untuk turun jalan.</p>
      </div>
      <div class="grid">
        <article class="service"><div class="num">01</div><h3>REPAIR</h3><p>Baiki masalah kereta dan pastikan semuanya kembali dalam keadaan terbaik.</p></article>
        <article class="service"><div class="num">02</div><h3>PERFORMANCE</h3><p>Upgrade performance untuk handling, power dan pengalaman pemanduan yang lebih mantap.</p></article>
        <article class="service"><div class="num">03</div><h3>CUSTOM BUILD</h3><p>Build kereta ikut style kau — dari look biasa sampai setup yang standout.</p></article>
        <article class="service"><div class="num">04</div><h3>MAINTENANCE</h3><p>Penjagaan berkala supaya jentera sentiasa bersedia untuk daily drive atau event.</p></article>
      </div>
    </section>

    <section id="about" class="split">
      <div>
        <p class="eyebrow">ABOUT RK GARAGE</p>
        <h2>BUILT FOR THE<br><em>STREETS.</em></h2>
      </div>
      <div class="about-copy">
        <p>RK Garage ialah sebuah automotive garage di dalam dunia Rumah Kita RP. Kami fokus pada servis, customisation dan performance dengan gaya yang clean, agresif dan professional.</p>
        <div class="stats">
          <div><strong>24/7</strong><span>GARAGE VIBES</span></div>
          <div><strong>RK</strong><span>TRUSTED CREW</span></div>
          <div><strong>∞</strong><span>CUSTOM BUILDS</span></div>
        </div>
      </div>
    </section>

    <section class="cta">
      <p class="eyebrow">READY TO BUILD?</p>
      <h2>YOUR CAR.<br><em>YOUR STYLE.</em></h2>
      <a class="btn primary" href="#contact">BOOK YOUR SLOT</a>
    </section>

    <section id="contact" class="contact section">
      <div>
        <p class="eyebrow">GET IN TOUCH</p>
        <h2>CONTACT<br><em>RK GARAGE</em></h2>
        <p>Untuk booking, pertanyaan atau urusan garage, terus hubungi team RK Garage.</p>
      </div>
      <div class="contact-box">
        <a href="#" class="contact-link"><span>DISCORD</span><b>JOIN SERVER →</b></a>
        <a href="#" class="contact-link"><span>WHATSAPP</span><b>CHAT NOW →</b></a>
        <a href="#" class="contact-link"><span>GARAGE</span><b>RUMAH KITA RP →</b></a>
      </div>
    </section>
  </main>

  <footer>
    <span>© 2026 RK GARAGE</span>
    <span>RUMAH KITA RP</span>
  </footer>
  <script src="script.js"></script>
</body>
</html>'''

css = r'''@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap');

:root{--bg:#080808;--panel:#111;--red:#d71920;--gold:#d8ad55;--white:#f5f5f5;--muted:#999}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--white);font-family:Inter,Arial,sans-serif}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.035;background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:45px 45px}
a{color:inherit;text-decoration:none}
.nav{height:78px;padding:0 6%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #222;background:rgba(8,8,8,.88);backdrop-filter:blur(12px);position:sticky;top:0;z-index:20}
.brand{font:800 27px 'Barlow Condensed';letter-spacing:1px}.brand span{color:var(--red);font-style:italic}
.nav nav{display:flex;gap:32px;font:600 13px 'Barlow Condensed';letter-spacing:1.5px;color:#bbb}.nav nav a:hover{color:#fff}
.nav-btn,.btn{display:inline-flex;align-items:center;justify-content:center;padding:13px 22px;font:800 13px 'Barlow Condensed';letter-spacing:1.5px;border:1px solid var(--red);transition:.2s}.nav-btn{background:var(--red)}.nav-btn:hover,.primary:hover{transform:translateY(-2px);box-shadow:0 10px 30px #d7192030}
.hero{min-height:calc(100vh - 78px);padding:8% 7%;display:flex;align-items:center;justify-content:space-between;position:relative;overflow:hidden}
.hero-glow{position:absolute;width:650px;height:650px;border-radius:50%;background:#d7192012;filter:blur(80px);right:-180px;top:10%}
.hero-content{max-width:720px;position:relative;z-index:2}.eyebrow{font:700 13px 'Barlow Condensed';letter-spacing:3px;color:var(--gold);margin-bottom:16px}
h1,h2{font:900 clamp(64px,9vw,132px)/.8 'Barlow Condensed';letter-spacing:-2px}h2{font-size:clamp(52px,7vw,92px)}em{font-style:normal;color:var(--red)}
.lead{max-width:560px;color:#aaa;line-height:1.7;margin:28px 0}.hero-actions{display:flex;gap:12px}.primary{background:var(--red)}.ghost{background:transparent;border-color:#444}.ghost:hover{border-color:var(--gold)}
.hero-card{width:360px;height:430px;border:1px solid #333;background:linear-gradient(145deg,#171717,#080808);padding:24px;display:flex;flex-direction:column;justify-content:space-between;transform:rotate(3deg);box-shadow:20px 30px 80px #000;position:relative}.hero-card:after{content:"";position:absolute;inset:14px;border:1px solid #ffffff12}.card-top,.card-bottom{display:flex;justify-content:space-between;font:700 13px 'Barlow Condensed';letter-spacing:2px;position:relative;z-index:2}.card-top span{color:var(--red);font-size:26px;font-style:italic}.car-silhouette{font:900 150px 'Barlow Condensed';color:#ffffff08;text-align:center;font-style:italic}
.section{padding:110px 7%;border-top:1px solid #1c1c1c}.section-head{max-width:700px;margin-bottom:55px}.section-head>p:last-child,.contact p:last-child{color:var(--muted);line-height:1.7;margin-top:20px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#292929}.service{background:var(--bg);padding:35px 28px;min-height:270px;transition:.25s}.service:hover{background:#111}.num{color:var(--red);font:800 15px 'Barlow Condensed';letter-spacing:2px;margin-bottom:55px}.service h3{font:800 30px 'Barlow Condensed';margin-bottom:12px}.service p{color:#888;line-height:1.7;font-size:14px}
.split{padding:110px 7%;display:grid;grid-template-columns:1fr 1fr;gap:10%;background:#0d0d0d}.about-copy{padding-top:15px;color:#aaa;line-height:1.8}.stats{display:flex;gap:45px;margin-top:50px}.stats div{display:flex;flex-direction:column}.stats strong{font:900 42px 'Barlow Condensed';color:var(--gold)}.stats span{font:600 11px 'Barlow Condensed';letter-spacing:1.5px;color:#666}
.cta{text-align:center;padding:130px 20px;border-top:1px solid #222;border-bottom:1px solid #222}.cta h2{margin:20px 0 35px}
.contact{display:grid;grid-template-columns:1fr 1fr;gap:10%}.contact-box{border-top:1px solid #333}.contact-link{display:flex;justify-content:space-between;padding:25px 0;border-bottom:1px solid #333;font:700 15px 'Barlow Condensed';letter-spacing:1px}.contact-link span{color:#888}.contact-link:hover b{color:var(--red)}
footer{padding:28px 7%;display:flex;justify-content:space-between;color:#555;font:600 11px 'Barlow Condensed';letter-spacing:2px}
@media(max-width:850px){.nav nav{display:none}.hero{padding-top:70px;flex-direction:column;align-items:flex-start;gap:60px}.hero-card{width:min(100%,360px);align-self:center}.grid{grid-template-columns:1fr 1fr}.split,.contact{grid-template-columns:1fr;gap:55px}.stats{gap:25px}.nav-btn{display:none}}
@media(max-width:520px){.hero{padding-left:6%;padding-right:6%}.section,.split{padding:80px 6%}.grid{grid-template-columns:1fr}.hero-actions{flex-direction:column;align-items:stretch}.hero-card{height:350px}.stats{flex-wrap:wrap}footer{padding:24px 6%}}
'''

js = r'''document.querySelectorAll('a[href^="#"]').forEach(a=>{
  a.addEventListener('click',e=>{
    const el=document.querySelector(a.getAttribute('href'));
    if(el){e.preventDefault();el.scrollIntoView({behavior:'smooth'});}
  });
});
'''

readme = r'''# RK Garage Website

Website landing page untuk RK Garage / Rumah Kita RP.

## Cara guna
1. Upload `index.html`, `style.css` dan `script.js` ke repository GitHub.
2. Aktifkan GitHub Pages pada branch utama.
3. Tukar link Discord/WhatsApp di bahagian `CONTACT` dalam `index.html`.
4. Kalau ada logo RK Garage, boleh gantikan teks `RK GARAGE` dengan imej logo.

Design: black + red + gold, responsive untuk desktop dan mobile.
'''

(root/"index.html").write_text(html, encoding="utf-8")
(root/"style.css").write_text(css, encoding="utf-8")
(root/"script.js").write_text(js, encoding="utf-8")
(root/"README.md").write_text(readme, encoding="utf-8")

zip_path = Path("/mnt/data/RK-Garage-Website.zip")
with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as z:
    for f in root.iterdir():
        z.write(f, f"RK-Garage/{f.name}")

print(f"Website siap: {zip_path}")
